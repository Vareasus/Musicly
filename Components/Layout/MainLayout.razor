    private async Task SetEqBand(string band, ChangeEventArgs e)
    {
        var val = int.Parse(e.Value?.ToString() ?? "0");
        switch (band)
        {
            case "bass": eqBass = val; break;
            case "mid": eqMid = val; break;
            case "treble": eqTreble = val; break;
        }
        await JS.InvokeVoidAsync("audioInterop.setEq", eqBass, eqMid, eqTreble);
    }

    private Task SetEqBass(ChangeEventArgs e) => SetEqBand("bass", e);
    private Task SetEqMid(ChangeEventArgs e) => SetEqBand("mid", e);
    private Task SetEqTreble(ChangeEventArgs e) => SetEqBand("treble", e);

    private async Task SetEqPreset(int bass, int mid, int treble)
    {
        eqBass = bass; eqMid = mid; eqTreble = treble;
        await JS.InvokeVoidAsync("audioInterop.setEq", bass, mid, treble);
    }

