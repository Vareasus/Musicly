    // ========= DOWNLOAD =========
    private async Task OnDownloadTrack()
    {
        var track = Player.CurrentTrack;
        if (!string.IsNullOrEmpty(track.Src))
        {
            var filename = $"{track.Artist} - {track.Title}";
            await JS.InvokeVoidAsync("audioInterop.downloadTrack", track.Src, filename);
        }
    }

    // ========= KEYBOARD SHORTCUTS =========
    [JSInvokable]
    public void OnShowShortcuts() => _ = InvokeAsync(() => { showShortcutsModal = true; StateHasChanged(); });

    [JSInvokable]
    public async Task OnKeyboardAction(string action)
    {
        switch (action)
        {
            case "togglePlay": await OnTogglePlay(); break;
            case "next": await OnNext(); break;
            case "prev": await OnPrev(); break;
            case "shuffle": OnShuffle(); break;
            case "repeat": OnRepeat(); break;
            case "like": await OnLikeToggle(); break;
            case "queue": Player.AddToQueue(Player.CurrentTrack); break;
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Player.OnStateChanged -= StateChanged;
        sleepTimer?.Dispose();
        _ = JS.InvokeVoidAsync("audioInterop.dispose");
        dotNetRef?.Dispose();
    }
