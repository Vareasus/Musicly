    [JSInvokable]
    public async Task OnTimeUpdate(double time)
    {
        Player.UpdateTime(time, Player.Duration);
        if (Player.IsPlaying)
        {
            Stats.RecordTimeSlice();
            _flushCounter++;
            if (_flushCounter >= 30)
            {
                _flushCounter = 0;
                await Stats.FlushAsync();
            }
        }
    }

    [JSInvokable]
    public void OnDurationChanged(double duration)
    {
        Player.Duration = duration;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnPlayStateChanged(bool playing)
    {
        if (playing && !Player.IsPlaying)
            await Stats.TrackStartedAsync(Player.CurrentTrack);
        Player.SetPlaying(playing);
    }

    [JSInvokable]
    public async Task OnTrackEnded()
    {
        var nextIdx = Player.GetNextTrackIndex();
        if (nextIdx >= 0)
        {
            Player.LoadTrack(nextIdx);
            await JS.InvokeVoidAsync("audioInterop.loadTrack", Player.CurrentTrack.Src);
            await JS.InvokeVoidAsync("audioInterop.play");
        }
        else
        {
            Player.SetPlaying(false);
        }
    }

    [JSInvokable]
    public async Task OnMuteToggle()
    {
        Player.ToggleMute();
        if (Player.IsMuted)
            await JS.InvokeVoidAsync("audioInterop.mute");
        else
            await JS.InvokeVoidAsync("audioInterop.unmute");
    }

    private async Task OnLikeToggle()
    {
        await Stats.ToggleLikeAsync(Player.CurrentTrack.Id);
        _lastLikeCheckTrackId = -1; // Force refresh
        await RefreshLikeState();
        _lastLikeCheckTrackId = Player.CurrentTrack.Id;
    }

    private async Task OnDislikeToggle()
    {
        await Stats.ToggleDislikeAsync(Player.CurrentTrack.Id);
        _lastLikeCheckTrackId = -1; // Force refresh
        await RefreshLikeState();
        _lastLikeCheckTrackId = Player.CurrentTrack.Id;
    }

    private async Task OnTogglePlay()
