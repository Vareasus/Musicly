            _ => ""
        };
    }

    private string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || seconds < 0) return "0:00";
        var m = (int)(seconds / 60);
        var s = (int)(seconds % 60);
        return $"{m}:{s:D2}";
    }

    private string GetProgressPercent()
    {
        if (Player.Duration <= 0) return "0";
        var pct = Math.Min(100, (Player.CurrentTime / Player.Duration) * 100);
        return pct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task OnSeekClick(MouseEventArgs e)
    {
        // This is handled by JS for more precise seeking
        // but we need this for Blazor event binding
    }

    private string FormatNotifTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return dt.ToString("dd MMM");
    }

    // ========= SLEEP TIMER =========
    private void ToggleSleepModal() => showSleepModal = !showSleepModal;

    private void SetSleep(int minutes)
    {
        sleepEndTime = DateTime.UtcNow.AddMinutes(minutes);
        sleepTimer?.Dispose();
        sleepTimer = new System.Threading.Timer(async _ =>
        {
            if (sleepEndTime.HasValue && DateTime.UtcNow >= sleepEndTime.Value)
            {
                await InvokeAsync(async () =>
                {
                    await JS.InvokeVoidAsync("audioInterop.pause");
                    Player.SetPlaying(false);
                    sleepEndTime = null;
                    sleepTimer?.Dispose();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
        showSleepModal = false;
    }

    private void CancelSleep()
    {
        sleepEndTime = null;
        sleepTimer?.Dispose();
        showSleepModal = false;
    }

    private string GetSleepRemaining()
    {
        if (!sleepEndTime.HasValue) return "";
        var remaining = sleepEndTime.Value - DateTime.UtcNow;
        if (remaining.TotalSeconds <= 0) return "0:00";
        return $"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}";
    }

