@page "/admin"
@implements IDisposable
@inject Musicly.Services.AuthService Auth
@inject Musicly.Services.ListeningStatsService Stats
@inject Musicly.Services.NotificationService NotifService
@inject Musicly.Services.MusicPlayerService Player
@inject Musicly.Services.CommentService CommentSvc
@inject Musicly.Services.SongRequestService ReqSvc
@inject Musicly.Services.TrackUploadService UploadSvc
@inject Musicly.Services.CustomAuthStateProvider AuthState
@inject NavigationManager Nav

<section class="admin-page">
    <div class="admin-header">
        <h1>Admin <span>Dashboard</span></h1>
        <p>Manage users, requests and monitor listening activity</p>
    </div>

    @if (!isAdmin)
    {
        <div class="glass-card" style="text-align:center;padding:60px;">
            <h3>🔒 Access Denied</h3>
            <p style="color:var(--text-secondary);">Only admins can view this page.</p>
        </div>
    }
    else
    {
        <!-- UPLOAD TRACK -->
        <div class="glass-card admin-notify-section">
            <h3>🎵 Şarkı Yükle</h3>
            <div class="admin-upload-form">
                <div class="upload-row">
                    <label class="upload-file-label">
                        <InputFile OnChange="OnFileSelected" accept=".mp3" />
                        <span class="upload-file-btn">📁 MP3 Dosya Seç</span>
                    </label>
                    @if (selectedFile != null)
                    {
                        <span class="upload-file-name">@selectedFile.Name (@FormatFileSize(selectedFile.Size))</span>
                    }
                </div>
                <div class="upload-fields">
                    <input type="text" @bind="uploadTitle" placeholder="Şarkı Adı *" class="admin-notify-input" />
                    <input type="text" @bind="uploadArtist" placeholder="Sanatçı" class="admin-notify-input" />
                </div>
                <div class="upload-fields">
                    <select @bind="uploadGenre" class="admin-notify-input">
                        <option value="Ambient">Ambient</option>
                        <option value="Pop">Pop</option>
                        <option value="Rock">Rock</option>
                        <option value="Hip-Hop">Hip-Hop</option>
                        <option value="Electronic">Electronic</option>
                        <option value="Jazz">Jazz</option>
                        <option value="Classical">Classical</option>
                        <option value="R&B">R&B</option>
                        <option value="Metal">Metal</option>
                        <option value="Folk">Folk</option>
                        <option value="Indie">Indie</option>
                    </select>
                    <select @bind="uploadMood" class="admin-notify-input">
                        <option value="Chill">Chill</option>
                        <option value="Energetic">Energetic</option>
                        <option value="Melancholic">Melancholic</option>
                        <option value="Happy">Happy</option>
                        <option value="Dark">Dark</option>
                        <option value="Romantic">Romantic</option>
                        <option value="Focus">Focus</option>
                    </select>
                </div>
                <div class="upload-gradient-presets">
                    <span style="color:var(--text-secondary);font-size:13px;">Renk:</span>
                    @foreach (var g in gradientPresets)
                    {
                        <button class="gradient-preset @(uploadGradient == g.Value ? "active" : "")"
                                style="background: @g.Value;" title="@g.Key"
                                @onclick="() => uploadGradient = g.Value"></button>
                    }
                </div>
                <button class="admin-notify-btn" @onclick="OnUploadTrack" disabled="@isUploading">
                    @(isUploading ? "Yükleniyor..." : "⬆️ Yükle")
                </button>
                @if (!string.IsNullOrEmpty(uploadMessage))
                {
                    <div class="@(uploadSuccess ? "auth-success" : "auth-error")" style="margin-top:12px;">@uploadMessage</div>
                }
            </div>
        </div>

        <!-- TRACK MANAGEMENT -->
        <div class="glass-card admin-users-section">
            <h3>🎶 Şarkılar (@Player.Tracks.Count)</h3>
            <div class="stats-table-wrapper">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Şarkı</th>
                            <th>Sanatçı</th>
                            <th>Tür</th>
                            <th>Mood</th>
                            <th>Dosya</th>
                            <th>Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Player.Tracks.Count; i++)
                        {
                            var track = Player.Tracks[i];
                            <tr>
                                <td class="rank">@(i + 1)</td>
                                <td style="font-weight:600;">@track.Title</td>
                                <td>@track.Artist</td>
                                <td>@track.Genre</td>
                                <td>@track.Mood</td>
                                <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:var(--text-secondary);">@track.Src</td>
                                <td>
                                    <button class="admin-delete-btn" @onclick="() => OnDeleteTrack(track.Id)">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- NOTIFY USERS -->
        <div class="glass-card admin-notify-section">
            <h3>📢 Send Notification</h3>
            <form @onsubmit="SendNotification" @onsubmit:preventDefault>
                <div class="admin-notify-row">
                    <input type="text" @bind="notifyMessage" placeholder="Tüm kullanıcılara mesaj gönder (örn: Yeni şarkı eklendi!)" class="admin-notify-input" />
                    <button type="submit" class="admin-notify-btn" disabled="@isSending">
                        @(isSending ? "Gönderiliyor..." : "Gönder")
                    </button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(notifySuccess))
            {
                <div class="auth-success" style="margin-top:12px;">✅ @notifySuccess</div>
            }
        </div>

        <!-- REQUESTS -->
        <div class="glass-card admin-users-section">
            <h3>📨 Talepler
                @if (pendingCount > 0)
                {
                    <span class="admin-pending-badge">@pendingCount yeni</span>
                }
            </h3>
            @if (allRequests.Count == 0)
            {
                <div class="profile-empty">Henüz talep yok</div>
            }
            else
            {
                <div class="admin-request-list">
                    @foreach (var r in allRequests)
                    {
                        <div class="admin-request-card @GetStatusClass(r.Status)">
                            <div class="admin-req-header">
                                <div class="admin-req-left">
                                    <span class="request-cat-badge" style="--cat-color: @GetCatColor(r.Category);">@GetCatEmoji(r.Category) @GetCatLabel(r.Category)</span>
                                    <span class="admin-req-title">@r.Title</span>
                                </div>
                                <span class="request-status-badge @GetStatusClass(r.Status)">@GetStatusText(r.Status)</span>
                            </div>
                            <div class="admin-req-meta">
                                <span>👤 @r.Username</span>
                                <span>📅 @r.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Description))
                            {
                                <p class="admin-req-desc">@r.Description</p>
                            }
                            @if (r.Status == Musicly.Models.RequestStatus.Pending)
                            {
                                <div class="admin-req-actions">
                                    <input type="text" @bind="responseTexts[r.Id]" placeholder="Yanıt mesajı (opsiyonel)" class="admin-response-input" />
                                    <button class="admin-approve-btn" @onclick="() => RespondToRequest(r.Id, Musicly.Models.RequestStatus.Approved)">✅ Onayla</button>
                                    <button class="admin-reject-btn" @onclick="() => RespondToRequest(r.Id, Musicly.Models.RequestStatus.Rejected)">❌ Reddet</button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(r.AdminResponse))
                            {
                                <div class="admin-req-response">
                                    <span class="admin-response-label">🛡️ Admin Yanıtı:</span>
                                    <p>@r.AdminResponse</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- USERS TABLE -->
        <div class="glass-card admin-users-section">
            <h3>👥 Users (@users.Count)</h3>
            <div class="stats-table-wrapper">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Registered</th>
                            <th>Total Plays</th>
                            <th>Listening Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < users.Count; i++)
                        {
                            var user = users[i];
                            var userPlays = userStats.GetValueOrDefault(user.Id, (0, 0));
                            <tr>
                                <td class="rank">@(i + 1)</td>
                                <td style="font-weight:600;">@user.Username</td>
                                <td>@user.Email</td>
                                <td><span class="role-badge @(user.Role == "Admin" ? "admin" : "user")">@user.Role</span></td>
                                <td class="date-cell">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="plays-cell">@userPlays.Item1</td>
                                <td>@Stats.FormatSeconds(userPlays.Item2)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- COMMENT MODERATION -->
        <div class="glass-card admin-users-section">
            <h3>💬 Comment Moderation (@allComments.Count)</h3>
            <div class="stats-table-wrapper">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Track</th>
                            <th>User</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            <th>Date</th>
                            <th>Likes</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < allComments.Count; i++)
                        {
                            var comment = allComments[i];
                            <tr>
                                <td class="rank">@(i + 1)</td>
                                <td style="font-weight:600;">@comment.TrackTitle</td>
                                <td>@comment.Username</td>
                                <td>
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span style="color:@(s <= comment.Rating ? "#ffd700" : "#555");font-size:12px;">★</span>
                                    }
                                </td>
                                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@comment.Text</td>
                                <td class="date-cell">@comment.CreatedAt.ToString("dd MMM HH:mm")</td>
                                <td class="plays-cell">@comment.LikeCount</td>
                                <td>
                                    <button class="admin-delete-btn" @onclick="() => DeleteComment(comment.Id)">🗑️ Sil</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ANALYTICS CHARTS -->
        <div class="glass-card admin-users-section">
            <h3>📊 Analitik Dashboard</h3>
            <div class="stats-overview" style="margin-bottom:24px;">
                <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#e94590,#7b2ff7);"><svg viewBox="0 0 24 24" width="24" height="24" fill="#fff"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55C7.79 13 6 14.79 6 17s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg></div><div class="stat-value">@Player.Tracks.Count</div><div class="stat-label">Toplam Şarkı</div></div>
                <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#4facfe,#00f2fe);"><svg viewBox="0 0 24 24" width="24" height="24" fill="#fff"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3z"/></svg></div><div class="stat-value">@users.Count</div><div class="stat-label">Kullanıcı</div></div>
                <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#43e97b,#38f9d7);"><svg viewBox="0 0 24 24" width="24" height="24" fill="#fff"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"/></svg></div><div class="stat-value">@allComments.Count</div><div class="stat-label">Yorum</div></div>
                <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#f093fb,#f5576c);"><svg viewBox="0 0 24 24" width="24" height="24" fill="#fff"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2z"/></svg></div><div class="stat-value">@totalPlatformListening</div><div class="stat-label">Platform Dinleme</div></div>
            </div>

            <div class="glass-card" style="padding:20px;margin-bottom:16px;">
                <h4 style="margin:0 0 16px;color:var(--text-primary);">🎵 Tür Dağılımı</h4>
                <div style="display:flex;flex-wrap:wrap;gap:12px;">
                    @foreach (var g in genreDistribution)
                    {
                        var pct = Player.Tracks.Count > 0 ? (g.Value * 100.0 / Player.Tracks.Count) : 0;
                        <div style="flex:1;min-width:140px;">
                            <div style="display:flex;justify-content:space-between;margin-bottom:4px;"><span style="font-size:13px;color:var(--text-primary);font-weight:500;">@g.Key</span><span style="font-size:12px;color:var(--text-secondary);">@g.Value</span></div>
                            <div style="background:var(--bg-glass);border-radius:6px;height:8px;overflow:hidden;"><div style="width:@(pct.ToString("0"))%;height:100%;background:var(--accent);border-radius:6px;"></div></div>
                        </div>
                    }
                </div>
            </div>

            <div class="glass-card" style="padding:20px;margin-bottom:16px;">
                <h4 style="margin:0 0 16px;color:var(--text-primary);">🏆 En Aktif Kullanıcılar</h4>
                @foreach (var u in topUsersByListening)
                {
                    var maxU = topUsersByListening.Count > 0 ? topUsersByListening[0].Secs : 1;
                    var bp = maxU > 0 ? (u.Secs * 100.0 / maxU) : 0;
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
                        <span style="font-size:18px;font-weight:700;color:@(u.Rank <= 3 ? "var(--accent)" : "var(--text-secondary)");min-width:28px;">@u.Rank</span>
                        <span style="min-width:80px;font-size:13px;font-weight:600;color:var(--text-primary);">@u.Name</span>
                        <div style="flex:1;background:var(--bg-glass);border-radius:6px;height:10px;overflow:hidden;"><div style="width:@(bp.ToString("0"))%;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-hover));border-radius:6px;"></div></div>
                        <span style="font-size:12px;color:var(--text-secondary);min-width:70px;text-align:right;">@Stats.FormatSeconds(u.Secs)</span>
                    </div>
                }
            </div>

            <div class="glass-card" style="padding:20px;">
                <h4 style="margin:0 0 16px;color:var(--text-primary);">🔥 En Çok Dinlenen Şarkılar</h4>
                @foreach (var t in topTracksByPlays)
                {
                    var maxP = topTracksByPlays.Count > 0 ? topTracksByPlays[0].Plays : 1;
                    var bp2 = maxP > 0 ? (t.Plays * 100.0 / maxP) : 0;
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
                        <span style="font-size:18px;font-weight:700;color:@(t.Rank <= 3 ? "var(--accent)" : "var(--text-secondary)");min-width:28px;">@t.Rank</span>
                        <span style="min-width:120px;font-size:13px;font-weight:600;color:var(--text-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@t.Title</span>
                        <div style="flex:1;background:var(--bg-glass);border-radius:6px;height:10px;overflow:hidden;"><div style="width:@(bp2.ToString("0"))%;height:100%;background:linear-gradient(90deg,#e94590,#7b2ff7);border-radius:6px;"></div></div>
                        <span style="font-size:12px;color:var(--text-secondary);min-width:40px;text-align:right;">@t.Plays</span>
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    private List<Musicly.Models.AppUser> users = new();
    private Dictionary<int, (int, double)> userStats = new();
    private bool isAdmin;
    private string notifyMessage = "";
    private string notifySuccess = "";
    private bool isSending;
    private List<CommentWithLikes> allComments = new();
    private List<Musicly.Models.SongRequest> allRequests = new();
    private Dictionary<int, string> responseTexts = new();
    private int pendingCount;
    private int adminUserId;

    // Analytics
    private string totalPlatformListening = "0m 0s";
    private Dictionary<string, int> genreDistribution = new();
    private List<(int Rank, string Name, double Secs)> topUsersByListening = new();
    private List<(int Rank, string Title, int Plays)> topTracksByPlays = new();

    // Upload
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedFile;
    private string uploadTitle = "";
    private string uploadArtist = "";
    private string uploadGenre = "Ambient";
    private string uploadMood = "Chill";
    private string uploadGradient = "linear-gradient(135deg, #1a1a2e, #16213e, #0f3460, #e94560)";
    private string uploadMessage = "";
    private bool uploadSuccess;
    private bool isUploading;

    private readonly Dictionary<string, string> gradientPresets = new()
    {
        ["Gece"] = "linear-gradient(135deg, #1a1a2e, #16213e, #0f3460, #e94560)",
        ["Okyanus"] = "linear-gradient(135deg, #0f0c29, #302b63, #24243e)",
        ["Gün Batımı"] = "linear-gradient(135deg, #fc4a1a, #f7b733)",
        ["Orman"] = "linear-gradient(135deg, #134e5e, #71b280)",
        ["Lav"] = "linear-gradient(135deg, #ed213a, #93291e)",
        ["Mor"] = "linear-gradient(135deg, #7b2ff7, #c471ed, #f7797d)",
        ["Altın"] = "linear-gradient(135deg, #f7971e, #ffd200)",
        ["Buz"] = "linear-gradient(135deg, #2193b0, #6dd5ed)",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            adminUserId = await AuthState.GetCurrentUserIdAsync();
            if (adminUserId <= 0) { Nav.NavigateTo("/login"); return; }

            var user = await Auth.GetUserAsync(adminUserId);
            isAdmin = user?.Role == "Admin";

            if (isAdmin)
            {
                users = await Auth.GetAllUsersAsync();
                foreach (var u in users)
                {
                    var plays = await Stats.GetTotalPlaysForUserAsync(u.Id);
                    var secs = await Stats.GetTotalListeningForUserAsync(u.Id);
                    userStats[u.Id] = (plays, secs);
                }
                allComments = await CommentSvc.GetAllCommentsAsync();
                allRequests = await ReqSvc.GetAllRequestsAsync();
                pendingCount = allRequests.Count(r => r.Status == Musicly.Models.RequestStatus.Pending);
                foreach (var r in allRequests.Where(r => r.Status == Musicly.Models.RequestStatus.Pending))
                {
                    responseTexts.TryAdd(r.Id, "");
                }

                // Analytics: Genre Distribution
                genreDistribution = Player.Tracks
                    .Where(t => !t.IsYouTube)
                    .GroupBy(t => t.Genre)
                    .ToDictionary(g => g.Key, g => g.Count())
                    .OrderByDescending(g => g.Value)
                    .ToDictionary(g => g.Key, g => g.Value);

                // Analytics: Top Users by Listening
                var rank = 1;
                topUsersByListening = userStats
                    .OrderByDescending(u => u.Value.Item2)
                    .Take(5)
                    .Select(u => {
                        var username = users.FirstOrDefault(x => x.Id == u.Key)?.Username ?? "?";
                        return (Rank: rank++, Name: username, Secs: u.Value.Item2);
                    }).ToList();

                // Analytics: Top Tracks by Plays
                var allStats = new List<Musicly.Models.UserTrackStats>();
                foreach (var u in users)
                {
                    var uStats = await Stats.GetAllStatsForUserAsync(u.Id);
                    allStats.AddRange(uStats);
                }
                var trackRank = 1;
                topTracksByPlays = allStats
                    .GroupBy(s => s.TrackId)
                    .Select(g => {
                        var trackName = Player.Tracks.FirstOrDefault(t => t.Id == g.Key)?.Title ?? $"Track #{g.Key}";
                        return (TrackId: g.Key, Title: trackName, TotalPlays: g.Sum(s => s.PlayCount));
                    })
                    .OrderByDescending(t => t.TotalPlays)
                    .Take(5)
                    .Select(t => (Rank: trackRank++, t.Title, Plays: t.TotalPlays))
                    .ToList();

                // Total platform listening
                var totalSecs = userStats.Values.Sum(v => v.Item2);
                totalPlatformListening = Stats.FormatSeconds(totalSecs);
            }
            StateHasChanged();
        }
    }

    private async Task SendNotification()
    {
        if (string.IsNullOrWhiteSpace(notifyMessage)) return;
        isSending = true;
        await NotifService.NotifyAllUsersAsync(notifyMessage);
        notifySuccess = $"\"{notifyMessage}\" — tüm kullanıcılara gönderildi!";
        notifyMessage = "";
        isSending = false;
    }

    private async Task RespondToRequest(int requestId, Musicly.Models.RequestStatus status)
    {
        var response = responseTexts.GetValueOrDefault(requestId, "");
        await ReqSvc.RespondToRequestAsync(requestId, status, response, adminUserId);
        allRequests = await ReqSvc.GetAllRequestsAsync();
        pendingCount = allRequests.Count(r => r.Status == Musicly.Models.RequestStatus.Pending);
        responseTexts.Clear();
        foreach (var r in allRequests.Where(r => r.Status == Musicly.Models.RequestStatus.Pending))
        {
            responseTexts.TryAdd(r.Id, "");
        }
    }

    private async Task DeleteComment(int commentId)
    {
        await CommentSvc.DeleteCommentAsync(commentId);
        allComments = await CommentSvc.GetAllCommentsAsync();
    }

    // ========= UPLOAD =========
    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        if (string.IsNullOrWhiteSpace(uploadTitle))
        {
            uploadTitle = Path.GetFileNameWithoutExtension(e.File.Name);
        }
    }

    private async Task OnUploadTrack()
    {
        if (selectedFile == null) { uploadMessage = "Lütfen bir MP3 dosyası seçin."; uploadSuccess = false; return; }
        isUploading = true;
        uploadMessage = "";
        StateHasChanged();

        var (success, message) = await UploadSvc.UploadTrackAsync(
            selectedFile, uploadTitle, uploadArtist, uploadGenre, uploadMood, uploadGradient, adminUserId);

        uploadMessage = message;
        uploadSuccess = success;
        isUploading = false;

        if (success)
        {
            selectedFile = null;
            uploadTitle = "";
            uploadArtist = "";
        }
    }

    private async Task OnDeleteTrack(int trackId)
    {
        await UploadSvc.DeleteTrackAsync(trackId);
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string GetStatusClass(Musicly.Models.RequestStatus status) => status switch
    {
        Musicly.Models.RequestStatus.Pending => "status-pending",
        Musicly.Models.RequestStatus.Approved => "status-approved",
        Musicly.Models.RequestStatus.Rejected => "status-rejected",
        _ => ""
    };

    private string GetStatusText(Musicly.Models.RequestStatus status) => status switch
    {
        Musicly.Models.RequestStatus.Pending => "⏳ Beklemede",
        Musicly.Models.RequestStatus.Approved => "✅ Onaylandı",
        Musicly.Models.RequestStatus.Rejected => "❌ Reddedildi",
        _ => ""
    };

    private string GetCatEmoji(Musicly.Models.RequestCategory cat) => cat switch
    {
        Musicly.Models.RequestCategory.Song => "🎵",
        Musicly.Models.RequestCategory.Feature => "💡",
        Musicly.Models.RequestCategory.Bug => "🐛",
