@page "/explore"
@implements IDisposable
@inject Musicly.Services.MusicPlayerService Player
@inject Musicly.Services.ListeningStatsService Stats
@inject IJSRuntime JS

<section class="explore-page">
    <div class="explore-header">
        <h1>Explore <span>Music</span></h1>
        <p>Discover tracks by genre, search for your favorites</p>
    </div>

    <!-- SEARCH -->
    <div class="explore-search-container">
        <div class="explore-search">
            <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
            <input type="text" placeholder="Search tracks, artists, genres..."
                   @bind="searchQuery" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <button class="search-clear" @onclick="() => searchQuery = string.Empty">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                    </svg>
                </button>
            }
        </div>
    </div>

    <!-- GENRE CARDS -->
    <div class="explore-section">
        <h2>Browse by Genre</h2>
        <div class="genre-grid">
            @foreach (var genre in genres)
            {
                <div class="genre-card @(selectedGenre == genre.Name ? "active" : "")"
                     style="background: @genre.Gradient;"
                     @onclick="() => OnGenreClick(genre.Name)">
                    <span class="genre-icon">@((MarkupString)genre.Icon)</span>
                    <span class="genre-name">@genre.Name</span>
                    <span class="genre-count">@GetGenreCount(genre.Name) tracks</span>
                </div>
            }
        </div>
    </div>

    <!-- SORT & TRACK RESULTS -->
    <div class="explore-section">
        <div class="explore-results-header">
            <h2>@(string.IsNullOrEmpty(selectedGenre) ? "All Tracks" : selectedGenre + " Tracks")</h2>
            <div class="sort-controls">
                <span class="sort-label">Sort by:</span>
                <button class="sort-btn @(sortBy == "title" ? "active" : "")" @onclick='() => sortBy = "title"'>Title</button>
                <button class="sort-btn @(sortBy == "artist" ? "active" : "")" @onclick='() => sortBy = "artist"'>Artist</button>
                <button class="sort-btn @(sortBy == "genre" ? "active" : "")" @onclick='() => sortBy = "genre"'>Genre</button>
            </div>
        </div>

        <div class="explore-track-list">
            @{ var tracks = GetFilteredTracks(); }
            @if (tracks.Count == 0)
            {
                <div class="explore-empty">
                    <span class="empty-icon">🔍</span>
                    <p>No tracks found. Try a different search or genre.</p>
                </div>
            }
            else
            {
                @for (int i = 0; i < tracks.Count; i++)
                {
                    var track = tracks[i];
                    var index = Player.Tracks.IndexOf(track);
                    var isActive = index == Player.CurrentTrackIndex;
                    var trackLiked = likedIds.Contains(track.Id);
                    var trackDisliked = dislikedIds.Contains(track.Id);

                    <div class="explore-track-item @(isActive ? "active-track" : "")" @onclick="() => OnTrackClick(index)">
                        <div class="explore-track-art" style="background: @track.GradientColor; background-size: 300% 300%;">
                            @if (!string.IsNullOrEmpty(track.CoverImage))
                            {
                                <img src="@track.CoverImage" alt="@track.Title" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
                            }
                            else
                            {
                                @((MarkupString)track.IconSvg)
                            }
                        </div>
                        <div class="explore-track-info">
                            <div class="explore-track-title">@track.Title</div>
                            <div class="explore-track-meta">@track.Artist</div>
                        </div>
                        <div class="explore-track-like-btns">
                            <button class="like-btn @(trackLiked ? "liked" : "")"
                                    title="Like" @onclick="() => OnToggleLike(track.Id)" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                </svg>
                            </button>
                            <button class="dislike-btn @(trackDisliked ? "disliked" : "")"
                                    title="Dislike" @onclick="() => OnToggleDislike(track.Id)" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z"/>
                                </svg>
                            </button>
                        </div>
                        <span class="explore-track-genre-badge" style="background: @GetGenreGradient(track.Genre);">@track.Genre</span>
                        <span class="explore-track-mood">@GetMoodEmoji(track.Mood) @track.Mood</span>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private string searchQuery = "";
    private string selectedGenre = "";
    private string sortBy = "title";
    private HashSet<int> likedIds = new();
    private HashSet<int> dislikedIds = new();

    private record GenreInfo(string Name, string Gradient, string Icon);

    private readonly List<GenreInfo> genres = new()
    {
        new("Ambient", "linear-gradient(135deg, #4facfe, #00f2fe)", "<svg viewBox='0 0 24 24' width='32' height='32' fill='rgba(255,255,255,0.9)'><path d='M12 3v10.55c-.59-.34-1.27-.55-2-.55C7.79 13 6 14.79 6 17s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z'/></svg>"),
        new("Cinematic", "linear-gradient(135deg, #e94560, #1a1a2e)", "<svg viewBox='0 0 24 24' width='32' height='32' fill='rgba(255,255,255,0.9)'><path d='M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z'/></svg>"),
        new("Electronic", "linear-gradient(135deg, #7b2ff7, #f093fb)", "<svg viewBox='0 0 24 24' width='32' height='32' fill='rgba(255,255,255,0.9)'><path d='M7 2v11h3v9l7-12h-4l4-8z'/></svg>"),
        new("Lo-Fi", "linear-gradient(135deg, #f5576c, #fda085)", "<svg viewBox='0 0 24 24' width='32' height='32' fill='rgba(255,255,255,0.9)'><path d='M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM4 12h4v2H4v-2zm10 6H4v-2h10v2zm6 0h-4v-2h4v2zm0-4H10v-2h10v2z'/></svg>"),
        new("Chill", "linear-gradient(135deg, #43e97b, #38f9d7)", "<svg viewBox='0 0 24 24' width='32' height='32' fill='rgba(255,255,255,0.9)'><path d='M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z'/></svg>"),
        new("Power", "linear-gradient(135deg, #ff512f, #dd2476)", "<svg viewBox='0 0 24 24' width='32' height='32' fill='rgba(255,255,255,0.9)'><path d='M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67z'/></svg>"),
    };

    protected override void OnInitialized()
    {
        Player.OnStateChanged += PlayerStateChanged;
        Stats.OnStatsChanged += StatsStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshLikeDislike();
            StateHasChanged();
        }
    }

    private async Task RefreshLikeDislike()
    {
        try
        {
            var liked = await Stats.GetLikedTrackIdsAsync();
            likedIds = liked.ToHashSet();
            dislikedIds = await Stats.GetDislikedTrackIdsAsync();
        }
        catch { }
    }

    // Player state changes (time update, play/pause) - UI only, no DB query
    private void PlayerStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    // Stats changes (like/dislike) - refresh from DB
    private void StatsStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshLikeDislike();
            StateHasChanged();
        });
    }

    private void OnGenreClick(string genre)
    {
        selectedGenre = selectedGenre == genre ? "" : genre;
    }

    private int GetGenreCount(string genre) => Player.GetTracksByGenre(genre).Count;

    private List<Musicly.Models.Track> GetFilteredTracks()
    {
        var tracks = string.IsNullOrEmpty(searchQuery)
            ? Player.GetTracksByGenre(selectedGenre)
            : Player.SearchTracks(searchQuery);

        return sortBy switch
        {
            "artist" => tracks.OrderBy(t => t.Artist).ToList(),
            "genre" => tracks.OrderBy(t => t.Genre).ToList(),
            _ => tracks.OrderBy(t => t.Title).ToList()
        };
    }

    private async Task OnTrackClick(int index)
    {
        Player.LoadTrack(index);
        await JS.InvokeVoidAsync("audioInterop.loadTrack", Player.CurrentTrack.Src);
        await JS.InvokeVoidAsync("audioInterop.play");
    }

    private async Task OnToggleLike(int trackId)
    {
        await Stats.ToggleLikeAsync(trackId);
        await RefreshLikeDislike();
    }

    private async Task OnToggleDislike(int trackId)
    {
        await Stats.ToggleDislikeAsync(trackId);
        await RefreshLikeDislike();
    }

    private string GetGenreGradient(string genre)
    {
        var g = genres.FirstOrDefault(x => x.Name == genre);
        return g?.Gradient ?? "linear-gradient(135deg, #667eea, #764ba2)";
    }

    private string GetMoodEmoji(string mood) => mood switch
    {
        "Chill" => "🌊",
        "Melancholy" => "🌧️",
        "Energetic" => "⚡",
        "Focus" => "🎯",
        _ => "🎵"
    };

    public void Dispose()
    {
        Player.OnStateChanged -= PlayerStateChanged;
        Stats.OnStatsChanged -= StatsStateChanged;
    }
}
