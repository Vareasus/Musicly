@page "/login"
@layout EmptyLayout
@inject Musicly.Services.AuthService Auth
@inject Musicly.Services.CustomAuthStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="#fff"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55C7.79 13 6 14.79 6 17s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            </div>
            <span class="auth-logo-text">Musicly</span>
        </div>
        <h1>Welcome Back</h1>
        <p class="auth-subtitle">Sign in to continue listening</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="auth-error">⚠️ @error</div>
        }

        <div class="auth-field">
            <label>Username</label>
            <input type="text" @bind="username" @bind:event="oninput" placeholder="Kullanıcı adı" />
        </div>
        <div class="auth-field">
            <label>Password</label>
            <input type="password" @bind="password" @bind:event="oninput" placeholder="Şifre" />
        </div>

        <div class="auth-remember">
            <label class="remember-label">
                <input type="checkbox" @bind="rememberMe" />
                <span class="remember-check"></span>
                <span>Beni Hatırla</span>
            </label>
        </div>

        <button type="button" class="auth-submit" disabled="@isLoading" @onclick="OnLogin">
            @if (isLoading) { <span class="auth-spinner"></span> }
            else { <span>Sign In</span> }
        </button>

        <div class="auth-link">
            Don't have an account? <a href="/register">Create one</a>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string error = "";
    private bool isLoading;
    private bool rememberMe;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if already logged in (Remember Me)
            try
            {
                var authState = await AuthState.GetAuthenticationStateAsync();
                if (authState.User.Identity?.IsAuthenticated == true)
                {
                    Nav.NavigateTo("/", forceLoad: true);
                }
            }
            catch { }
        }
    }

    private async Task OnLogin()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "Tüm alanlar zorunludur";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var user = await Auth.LoginAsync(username, password);
            if (user == null)
            {
                error = "Kullanıcı adı veya şifre hatalı";
                isLoading = false;
                StateHasChanged();
                return;
            }
            await AuthState.LoginAsync(user, rememberMe);
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = "Bağlantı hatası, tekrar deneyin";
            isLoading = false;
            StateHasChanged();
        }
    }
}
