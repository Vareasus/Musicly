@implements IDisposable
@inject Musicly.Services.MusicPlayerService Player
@inject IJSRuntime JS

<div class="glass-card now-playing">
    <div class="album-art-container">
        <div class="album-art @(Player.IsPlaying ? "playing" : "paused")" style="background: @Player.CurrentTrack.GradientColor; background-size: 300% 300%;">
            <span class="note">
                <svg viewBox="0 0 24 24" width="64" height="64" fill="rgba(255,255,255,0.7)"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55C7.79 13 6 14.79 6 17s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            </span>
            <div class="vinyl-ring"></div>
        </div>
    </div>
    <div class="song-info">
        <div class="song-title">@Player.CurrentTrack.Title</div>
        <div class="song-artist">@Player.CurrentTrack.Artist</div>
    </div>
    <div class="progress-container">
        <div id="mainSeekBar" class="seek-container">
            <div class="seek-fill" style="width: @GetProgressCss();"></div>
            <div class="seek-thumb" style="left: @GetProgressCss();"></div>
        </div>
        <div class="progress-times">
            <span>@FormatTime(Player.CurrentTime)</span>
            <span>@FormatTime(Player.Duration)</span>
        </div>
    </div>
    <div class="controls">
        <button class="ctrl-btn @(Player.IsShuffled ? "active" : "")" title="Shuffle @(Player.IsShuffled ? "(On)" : "(Off)")" @onclick="OnShuffle">
            <svg viewBox="0 0 24 24"><path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></svg>
        </button>
        <button class="ctrl-btn" title="Previous" @onclick="OnPrev">
            <svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
        </button>
        <button class="play-btn" title="Play / Pause" @onclick="OnTogglePlay">
            @if (Player.IsPlaying)
            {
                <svg viewBox="0 0 24 24" fill="#fff"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
            }
        </button>
        <button class="ctrl-btn" title="Next" @onclick="OnNext">
            <svg viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
        </button>
        <button class="ctrl-btn @GetRepeatClass()" title="Repeat (@Player.Repeat)" @onclick="OnRepeat">
            @if (Player.Repeat == RepeatMode.One)
            {
                <svg viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/><text x="12" y="16" text-anchor="middle" font-size="7" font-weight="bold" fill="currentColor">1</text></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></svg>
            }
        </button>
        <button class="ctrl-btn" title="İndir" @onclick="OnDownloadTrack">
            <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        </button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Player.OnStateChanged += StateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initSeekBar", "mainSeekBar");
        }
    }

    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnTogglePlay()
    {
        await JS.InvokeVoidAsync("audioInterop.togglePlay");
    }

    private async Task OnPrev()
    {
        Player.PrevTrack();
        await JS.InvokeVoidAsync("audioInterop.loadTrack", Player.CurrentTrack.Src);
        if (Player.IsPlaying)
            await JS.InvokeVoidAsync("audioInterop.play");
    }

    private async Task OnNext()
    {
        Player.NextTrack();
        await JS.InvokeVoidAsync("audioInterop.loadTrack", Player.CurrentTrack.Src);
        if (Player.IsPlaying)
            await JS.InvokeVoidAsync("audioInterop.play");
    }

    private void OnShuffle() => Player.ToggleShuffle();
    private void OnRepeat() => Player.CycleRepeat();

    private string GetRepeatClass()
    {
        return Player.Repeat switch
        {
            RepeatMode.All => "active",
            RepeatMode.One => "active repeat-one",
            _ => ""
        };
    }

    private string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || seconds < 0) return "0:00";
        var m = (int)(seconds / 60);
        var s = (int)(seconds % 60);
        return $"{m}:{s:D2}";
    }

    private string GetProgressCss()
    {
        if (Player.Duration <= 0) return "0%";
        var pct = (Player.CurrentTime / Player.Duration) * 100;
        return pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private async Task OnDownloadTrack()
    {
        var track = Player.CurrentTrack;
        if (!string.IsNullOrEmpty(track.Src))
        {
            var filename = $"{track.Artist} - {track.Title}";
            await JS.InvokeVoidAsync("audioInterop.downloadTrack", track.Src, filename);
        }
    }

    public void Dispose()
    {
        Player.OnStateChanged -= StateChanged;
    }
}
